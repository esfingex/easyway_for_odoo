{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Odoo",
            "type": "python",
            "request": "launch",
            "stopOnEntry": false,
            "console": "integratedTerminal",
            "program": "odoo/odoo-bin",
            "args": [
                "--config=odoo.conf",
                "--dev=xml",
            ],
        },
    ]
}
